rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /*
     * Merge these donation rules into your existing Firebase Console rules.
     * Do not deploy this file as a full replacement unless you also keep your
     * current organization / mission / user rules here.
     */

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.email.matches('.*@admin[.]kalinga[.]com') ||
        request.auth.token.email.matches('admin@.*')
      );
    }

    function ownsCampaign(campaignId) {
      return signedIn() &&
        get(/databases/$(database)/documents/donation_campaigns/$(campaignId)).data.orgId
          == request.auth.uid;
    }

    function isOrgTeamOf(orgId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/organizations/$(orgId)/team/$(request.auth.uid));
    }

    function ownsMission(missionId) {
      return signedIn() && (
        exists(/databases/$(database)/documents/organizations/$(request.auth.uid)/missions/$(missionId))
        || (
          exists(/databases/$(database)/documents/mission_submissions/$(missionId))
          && (
            get(/databases/$(database)/documents/mission_submissions/$(missionId)).data.get('orgId', '')
              == request.auth.uid
            || get(/databases/$(database)/documents/mission_submissions/$(missionId)).data.get('organizationId', '')
              == request.auth.uid
          )
        )
      );
    }

    function canReadMission(missionId) {
      return signedIn() && (
        isAdmin()
        || ownsMission(missionId)
        || exists(/databases/$(database)/documents/mission_submissions/$(missionId))
        || exists(/databases/$(database)/documents/organizations/$(request.auth.uid)/missions/$(missionId))
      );
    }

    match /donation_campaigns/{campaignId} {
      allow read: if resource.data.status == 'published' ||
        (signedIn() && (
          isAdmin() ||
          resource.data.orgId == request.auth.uid ||
          isOrgTeamOf(resource.data.orgId)
        ));

      allow create: if signedIn() &&
        request.resource.data.orgId == request.auth.uid &&
        request.resource.data.status in ['draft', 'pending_approval'] &&
        request.resource.data.raisedAmountCentavos == 0 &&
        request.resource.data.donorCount == 0 &&
        request.resource.data.get('settledAmountCentavos', 0) == 0;

      allow update: if isAdmin() ||
        (signedIn() &&
          resource.data.orgId == request.auth.uid &&
          (
            resource.data.status in ['draft', 'rejected'] ||
            (resource.data.status == 'published' && request.resource.data.status == 'closed') ||
            (resource.data.status in ['draft', 'rejected'] &&
              request.resource.data.status == 'pending_approval')
          ) &&
          request.resource.data.raisedAmountCentavos == resource.data.raisedAmountCentavos &&
          request.resource.data.donorCount == resource.data.donorCount &&
          request.resource.data.get('settledAmountCentavos', 0) ==
            resource.data.get('settledAmountCentavos', 0)
        ) ||
        // Donor (or payment confirmation client) may only bump totals + recentDonations.
        (signedIn() &&
          resource.data.status == 'published' &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['raisedAmountCentavos', 'donorCount', 'recentDonations', 'updatedAt']) &&
          request.resource.data.raisedAmountCentavos >= resource.data.raisedAmountCentavos &&
          request.resource.data.donorCount >= resource.data.donorCount);

      allow delete: if isAdmin() ||
        (signedIn() &&
          resource.data.orgId == request.auth.uid &&
          resource.data.status in ['draft', 'rejected']);

      // Actual donor list used by the org campaign details page.
      match /donors/{donorId} {
        allow read: if signedIn() && (
          isAdmin() ||
          resource.data.userId == request.auth.uid ||
          ownsCampaign(campaignId) ||
          isOrgTeamOf(get(/databases/$(database)/documents/donation_campaigns/$(campaignId)).data.orgId)
        );
        allow create, update: if signedIn() && (
          request.resource.data.userId == request.auth.uid ||
          ownsCampaign(campaignId) ||
          isAdmin()
        );
        allow delete: if false;
      }

      // Legacy / alternate receipt path.
      match /transactions/{donationId} {
        allow read: if signedIn() && (
          isAdmin() ||
          resource.data.volunteerId == request.auth.uid ||
          ownsCampaign(campaignId) ||
          isOrgTeamOf(get(/databases/$(database)/documents/donation_campaigns/$(campaignId)).data.orgId)
        );
        allow create, update: if signedIn() &&
          request.resource.data.volunteerId == request.auth.uid &&
          request.resource.data.campaignId == campaignId;
        allow delete: if false;
      }

      // Post-campaign story updates (text + photos).
      match /updates/{updateId} {
        allow read: if
          get(/databases/$(database)/documents/donation_campaigns/$(campaignId)).data.status == 'published' ||
          (signedIn() && (
            isAdmin() ||
            ownsCampaign(campaignId) ||
            isOrgTeamOf(get(/databases/$(database)/documents/donation_campaigns/$(campaignId)).data.orgId)
          ));
        allow create, update, delete: if signedIn() && (
          isAdmin() ||
          ownsCampaign(campaignId) ||
          isOrgTeamOf(get(/databases/$(database)/documents/donation_campaigns/$(campaignId)).data.orgId)
        );
      }
    }

    match /donations/{donationId} {
      allow read: if signedIn() && (
        isAdmin() ||
        resource.data.volunteerId == request.auth.uid ||
        resource.data.orgId == request.auth.uid ||
        ownsCampaign(resource.data.campaignId) ||
        isOrgTeamOf(resource.data.orgId)
      );
      // Prefer Admin SDK when available; allow donor self-write for sandbox/local.
      allow create, update: if signedIn() &&
        request.resource.data.volunteerId == request.auth.uid;
      allow delete: if false;
    }

    match /payment_events/{eventId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Admin manual payouts from platform Maya merchant → organizations.
    match /donation_settlements/{settlementId} {
      allow read: if isAdmin() ||
        (signedIn() && (
          resource.data.orgId == request.auth.uid ||
          isOrgTeamOf(resource.data.orgId)
        ));
      allow create: if isAdmin() &&
        request.resource.data.amountCentavos is int &&
        request.resource.data.amountCentavos > 0 &&
        request.resource.data.status == 'completed';
      allow update, delete: if isAdmin();
    }

    // Admin-managed platform settings (hotlines, rewards config, etc.)
    match /platform_config/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Legacy top-level missions announcements (read-only; new writes go under org missions).
    match /missions/{missionId}/announcements/{announcementId} {
      allow read: if canReadMission(missionId);
      allow create, update, delete: if false;
    }

    // Canonical mission announcements under organizations/{orgId}/missions/{missionId}.
    match /organizations/{orgId}/missions/{missionId}/announcements/{announcementId} {
      allow read: if signedIn() && (
        isAdmin()
        || request.auth.uid == orgId
        || isOrgTeamOf(orgId)
        || canReadMission(missionId)
      );
      allow create: if signedIn()
        && (request.auth.uid == orgId || isOrgTeamOf(orgId))
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.orgId == orgId;
      allow update, delete: if signedIn() && (
        request.auth.uid == orgId || isOrgTeamOf(orgId) || isAdmin()
      );
    }

    // Org-scoped mission applications.
    match /organizations/{orgId}/missions/{missionId}/applications/{applicationId} {
      allow read: if signedIn() && (
        isAdmin()
        || request.auth.uid == orgId
        || isOrgTeamOf(orgId)
        || resource.data.userId == request.auth.uid
      );
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.missionId == missionId;
      allow update: if signedIn() && (
        isAdmin()
        || request.auth.uid == orgId
        || isOrgTeamOf(orgId)
        || resource.data.userId == request.auth.uid
      );
      allow delete: if signedIn() && (
        isAdmin() || request.auth.uid == orgId || isOrgTeamOf(orgId)
      );
    }

    // Team users for organization accounts:
    // match /organizations/{orgId}/team/{memberId} {
    //   allow read, write: if signedIn() && request.auth.uid == orgId;
    // }
    // match /org_team_usernames/{username} {
    //   allow read: if true;
    //   allow create, update: if signedIn();
    // }
  }
}
